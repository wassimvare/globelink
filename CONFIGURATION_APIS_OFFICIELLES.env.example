# Copie ce fichier en .env.local puis remplace les valeurs vides par tes vraies cles.
# Ne mets jamais ces cles en VITE_ : elles doivent rester cote serveur.

# Hotels - Booking.com Demand API
BOOKING_API_TOKEN=
# Si ton contrat Booking utilise ce nom au lieu de BOOKING_API_TOKEN :
BOOKING_PARTNER_API_KEY=
BOOKING_AFFILIATE_ID=
BOOKING_API_BASE_URL=https://demandapi.booking.com/3.1
BOOKING_ACCOMMODATIONS_SEARCH_ENDPOINT=https://demandapi.booking.com/3.1/accommodations/search

# Activites - Tripadvisor Content API
TRIPADVISOR_API_KEY=
TRIPADVISOR_API_BASE_URL=https://api.content.tripadvisor.com/api/v1

# Activites - GetYourGuide Partner API
GETYOURGUIDE_API_KEY=
# Si ton contrat GetYourGuide utilise ce nom au lieu de GETYOURGUIDE_API_KEY :
GETYOURGUIDE_PARTNER_API_KEY=
GETYOURGUIDE_API_BASE_URL=https://api.getyourguide.com/1

# Restaurants - Yelp Fusion API
YELP_API_KEY=
YELP_API_BASE_URL=https://api.yelp.com/v3

# Photos exactes Google Places, optionnel mais fortement recommande pour les restaurants.
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=
