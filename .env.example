# Public client configuration (safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server-only configuration — never prefix secrets with VITE_
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
LOVABLE_API_KEY=server-only
TAVILY_API_KEY=server-only
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_AI_PRO_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
PUBLIC_APP_URL=https://your-domain.example

# Facultatif : uniquement pour les anciennes fonctions IA serveur et le radar
# Le conseiller utilisateur fonctionne sans clé grâce à Puter.js.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Identifiant UUID du seul compte autorisé à initialiser le premier admin
ADMIN_BOOTSTRAP_USER_ID=

# Optionnel : résultats web récents pour l'IA de voyage
TAVILY_API_KEY=

# Optionnel : serveur TURN pour fiabiliser les appels entre réseaux différents.
# Sans TURN, les appels fonctionnent surtout sur le même Wi-Fi et sur les réseaux NAT compatibles.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
